{
  "name": "ai-studio",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:client": "bun run --cwd packages/client dev",
    "dev:server": "bun run --cwd packages/server dev",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\" --names server,client --prefix-colors blue,green",
    "build": "bun run --filter client build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint-react/eslint-plugin": "^5.8.6",
    "concurrently": "^10.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-refresh": "^0.5.2"
  }
}
